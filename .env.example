# GERMINA — variáveis de ambiente necessárias
#
# Copie este arquivo para `.env.local` (NUNCA para `.env` versionado) e
# preencha com as credenciais do projeto Supabase real. `.env.local` já está
# no .gitignore (padrão `.env*.local`) — nunca remova essa entrada nem
# commite um arquivo com valores reais.
#
# Onde encontrar cada valor: no painel do Supabase, em
# Project Settings → API.

# URL do projeto (ex: https://xxxxxxxxxxxx.supabase.co)
# Pública de propósito — é usada no navegador, por isso o prefixo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=

# Chave "anon" / "public" (também em Project Settings → API).
# Pública de propósito — o navegador usa essa chave em toda query; é a RLS
# (Row Level Security, já aplicada nas migrations) que garante isolamento
# entre usuários, não o sigilo desta chave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service_role" (mesma tela, Project Settings → API).
# ⚠️ NUNCA prefixar com NEXT_PUBLIC_. Esta chave ignora TODA política de RLS
# — só é lida em app/api/conta/route.ts (Route Handler, roda só no
# servidor), para a exclusão de conta via Admin API
# (supabase.auth.admin.deleteUser). Ver lib/supabase/admin.ts para o porquê
# e o guard de segurança.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app (opcional). Usada em metadataBase, que resolve as URLs
# de preview de link (Open Graph / Twitter card). Se não definida, o padrão
# é a produção na Vercel. Defina-a nos deploys de preview para que eles
# resolvam para si mesmos em vez de para a produção.
NEXT_PUBLIC_SITE_URL=
